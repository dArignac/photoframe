#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  if ! getent group photoframe >/dev/null 2>&1; then
    groupadd --system photoframe
  fi
  if ! getent passwd photoframe >/dev/null 2>&1; then
    useradd --system --gid photoframe --home-dir /etc/photoframe --no-create-home --shell /usr/sbin/nologin photoframe
  else
    usermod -d /etc/photoframe photoframe >/dev/null 2>&1 || true
  fi

  mkdir -p /etc/photoframe/images
  chown -R photoframe:photoframe /etc/photoframe
  chmod 0755 /etc/photoframe
  chmod 0755 /etc/photoframe/images

  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable photoframe.service >/dev/null || true
    systemctl restart photoframe.service >/dev/null || systemctl start photoframe.service >/dev/null || true
  fi
fi

exit 0

