#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
  if ! getent group photoframe >/dev/null 2>&1; then
    groupadd --system photoframe
  fi
  if ! getent passwd photoframe >/dev/null 2>&1; then
    useradd --system --gid photoframe --home-dir /var/lib/photoframe --no-create-home --shell /usr/sbin/nologin photoframe
  fi

  mkdir -p /var/lib/photoframe/images
  mkdir -p /etc/photoframe
  chown -R photoframe:photoframe /var/lib/photoframe

  if command -v systemctl >/dev/null 2>&1; then
    systemctl daemon-reload || true
    systemctl enable photoframe.service >/dev/null || true
    systemctl restart photoframe.service >/dev/null || systemctl start photoframe.service >/dev/null || true
  fi
fi

exit 0

